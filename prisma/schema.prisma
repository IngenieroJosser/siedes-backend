generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                        String   @id @default(cuid())
  nombre                    String
  apellido                  String
  email                     String   @unique
  identificacion            String?   @unique
  telefono                  String?
  password                  String
  rol                       Rol
  creadoEn                  DateTime @default(now())
  actualizadoEn             DateTime @updatedAt
  activo                    Boolean @default(true)

  // Relaciones
  estudiante                Estudiante?
  solicitudes               SolicitudAyuda[]
}

model Estudiante {
  id                        String   @id @default(cuid())
  usuarioId                 String   @unique
  edad                      Int
  genero                    String
  etnia                     Etnia   @default(NINGUNA)
  grado                     String
  riesgoDesercion           Float   @default(0.0) // Valor predictivo (0-1)

  institucionId             String
  creadoEn                  DateTime @default(now())
  actualizadoEn             DateTime @updatedAt

  // Soft delete
  activo                    Boolean  @default(true)

  // Relaciones           
  usuario                   Usuario  @relation(fields: [usuarioId], references: [id])
  institucion               Institucion @relation(fields: [institucionId], references: [id])
  registros                 RegistroAcademico[]
  alertas                   AlertaDesercion[]
  contexto                  ContextoEstudiante?
  intervenciones            Intervencion[]
  asignacionesBeneficios    AsignacionBeneficio[]  // Relación añadida
  solicitudesRapidas        SolicitudAyudaRapida[]
  prediccionesRiesgo        PrediccionRiesgo[]
  outcomes                  OutcomeEstudiantePeriodo[]

}

model Institucion {
  id                        String   @id @default(cuid())
  nombre                    String
  direccion                 String
  ciudad                    CiudadesUIUB @default(OTRA_CIUDAD)
  departamento              Departamento @default(OTRO)
  tipo                      TipoInstitucion @default(UNIVERSIDAD)  // Pública, Privada, etc.
  codigoDANE                String?  // Código único del Ministerio de Educación
  creadoEn                  DateTime @default(now())
  deletedAt                 DateTime?

  // Relaciones
  estudiantes               Estudiante[]
  solicitudesRapidas        SolicitudAyudaRapida[]
}

model RegistroAcademico {
  id                        String   @id @default(cuid())
  estudianteId              String
  periodo                   String   // Ejemplo: "2025-I"
  promedio                  Float
  inasistencias             Int
  observaciones             String?
  materiasAprobadas         Int
  materiasReprobadas        Int
  comportamiento            Int?     // Escala 1-10

  creadoEn                  DateTime @default(now())
  estudiante                Estudiante @relation(fields: [estudianteId], references: [id])
}

model AlertaDesercion {
  id                        String   @id @default(cuid())
  estudianteId              String
  nivelRiesgo               NivelRiesgo   // bajo, medio, alto
  descripcion               String
  factores                  String[]      // Factores que contribuyen al riesgo
  creadaEn                  DateTime @default(now())
  revisada                  Boolean @default(false)
  fechaRevision             DateTime?

  estudiante                Estudiante @relation(fields: [estudianteId], references: [id])
}

model SolicitudAyuda {
  id                        String   @id @default(cuid())
  usuarioId                 String
  tipo                      TipoSolicitud   // psicológica, económica, académica
  mensaje                   String
  estado                    EstadoSolicitud @default(PENDIENTE)
  creadoEn                  DateTime @default(now())
  prioridad                 PrioridadSolicitud @default(MEDIA)

  usuario                   Usuario @relation(fields: [usuarioId], references: [id])
}

model Beneficio {
  id                        String   @id @default(cuid())
  nombre                    String
  descripcion               String
  tipo                      TipoBeneficio   // beca, alimentación, transporte, etc.
  criteriosElegibilidad     String[]        // Criterios para acceder al beneficio
  activo                    Boolean @default(true)
  creadoEn                  DateTime @default(now())
  
  // Relaciones
  asignaciones              AsignacionBeneficio[]  // Relación inversa
}

model AsignacionBeneficio {
  id                        String   @id @default(cuid())
  estudianteId              String
  beneficioId               String
  fechaAsignacion           DateTime @default(now())
  fechaVencimiento          DateTime?
  estado                    EstadoAsignacion @default(ACTIVA)
  comentarios               String?

  estudiante                Estudiante @relation(fields: [estudianteId], references: [id])
  beneficio                 Beneficio @relation(fields: [beneficioId], references: [id])
}

model ContextoEstudiante {
  id                        String   @id @default(cuid())
  estudianteId              String   @unique
  distanciaEscuela          Float    // km
  tiempoDesplazamiento      Int      // minutos
  trabaja                   Boolean  @default(false)
  horasTrabajo              Int?
  ingresosFamiliares        Int?     // Rango de ingresos mensuales
  personasHogar             Int
  apoyoFamiliar             Boolean  @default(true)
  accesoInternet            Boolean  @default(false)
  dispositivoElectronico    Boolean  @default(false)
  participacionComunitaria  Boolean  @default(false)
  conocimientosAncestrales  Boolean  @default(false)
  situacionesEspeciales     String?  // Situaciones de vulnerabilidad específicas
  necesidadesEspeciales     String?  // Necesidades educativas especiales
  
  estudiante                Estudiante @relation(fields: [estudianteId], references: [id])
}

model Intervencion {
  id                        String   @id @default(cuid())
  estudianteId              String
  tipo                      TipoIntervencion
  descripcion               String
  fechaInicio               DateTime
  fechaFin                  DateTime?
  estado                    EstadoIntervencion @default(ACTIVA)
  efectividad               Float?   // 0-1, evaluada posteriormente
  recursosUtilizados        String[]
  participantes             String[] // Quiénes participaron (docentes, familia, etc.)
  observaciones             String?
  creadoEn                  DateTime @default(now())
  
  estudiante                Estudiante @relation(fields: [estudianteId], references: [id])
}

model PrediccionRiesgo {
  id                        String   @id @default(cuid())
  estudianteId              String
  probability               Float
  nivelRiesgo               NivelRiesgo
  modelType                 String
  modelVersion              String
  institutionalPrior        Float?
  factores                  Json?
  warnings                  Json?
  creadaEn                  DateTime @default(now())

  estudiante                Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@index([estudianteId, creadaEn])
  @@index([modelVersion])
}

model OutcomeEstudiantePeriodo {
  id                        String   @id @default(cuid())
  estudianteId              String
  periodoObservacion        String
  periodoResultado          String
  estadoResultado           EstadoPermanencia
  desertoSiguientePeriodo   Boolean
  registradoEn              DateTime @default(now())
  actualizadoEn             DateTime @updatedAt

  estudiante                Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, periodoObservacion, periodoResultado])
  @@index([periodoResultado, desertoSiguientePeriodo])
}

model IndicadorEtnico {
  id                        String   @id @default(cuid())
  nombre                    String
  descripcion               String
  peso                      Float    // 0-1, importancia en el cálculo de riesgo
  activo                    Boolean @default(true)
  categoria                 CategoriaIndicador
  creadoEn                  DateTime @default(now())
}

model FactorRiesgo {
  id                        String   @id @default(cuid())
  institucionId             String
  nombre                    String
  descripcion               String
  categoria                 CategoriaFactor
  peso                      Float    // 0-1, importancia en el cálculo de riesgo
  activo                    Boolean @default(true)
  creadoEn                  DateTime @default(now())
}

model SolicitudAyudaRapida {
  id                        String @id @default(cuid())
  tipoSolicitante           TipoSolicitante
  nombre                    String
  email                     String
  telefono                  String

  institucionId             String
  institucion               Institucion @relation(fields: [institucionId], references: [id])

  estudianteId              String
  estudiante                Estudiante @relation(fields: [estudianteId], references: [id])

  motivo                    MotivoSolicitud
  descripcion               String
}

// Enums extendidos
enum Rol {
  ADMIN
  DOCENTE
  PADRE
  ESTUDIANTE
  COORDINADOR
  LIDER_COMUNITARIO
}

enum EstadoPermanencia {
  ACTIVO
  PROMOVIDO
  REPROBADO
  TRANSFERIDO
  GRADUADO
  DESERTO
}

enum EstadoSolicitud {
  PENDIENTE
  EN_PROCESO
  RESUELTA
  RECHAZADA
}

enum Etnia {
  AFRODESCENDIENTE   // Afrocolombiano(a)
  INDIGENA           // Pueblos indígenas
  ROM                // Pueblo gitano (ROM)
  RAIZAL             // Raizal del Archipiélago de San Andrés
  PALENQUERO         // San Basilio de Palenque
  NINGUNA            // No se autorreconoce en grupo étnico
}

// Nuevos enums
enum NivelRiesgo {
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum TipoSolicitud {
  PSICOLOGICA
  ECONOMICA
  ACADEMICA
  ALIMENTARIA
  TRANSPORTE
  OTRA
}

enum PrioridadSolicitud {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TipoBeneficio {
  BECA
  ALIMENTACION
  TRANSPORTE
  UNIFORME
  UTILES
  PSICOLOGICA
  OTRO
}

enum EstadoAsignacion {
  ACTIVA
  SUSPENDIDA
  FINALIZADA
}

enum TipoIntervencion {
  ACADEMICA
  PSICOLOGICA
  ECONOMICA
  FAMILIAR
  COMUNITARIA
  CULTURAL
  TUTORIA
  OTRA
}

enum EstadoIntervencion {
  ACTIVA
  COMPLETADA
  SUSPENDIDA
  CANCELADA
}

enum CategoriaIndicador {
  ACADEMICA
  SOCIOECONOMICA
  CULTURAL
  CONTEXTUAL
  INSTITUCIONAL
}

enum CategoriaFactor {
  ACADEMICO
  ECONOMICO
  FAMILIAR
  PERSONAL
  INSTITUCIONAL
  COMUNITARIO
  CULTURAL
}

enum TipoInstitucion {
  PREESCOLAR
  PRIMARIA
  SECUNDARIA
  MEDIA
  TECNICA
  TECNOLOGICA
  UNIVERSIDAD
  INSTITUTO
  OTRO
}

enum Departamento {
  AMAZONAS
  ANTIOQUIA
  ARAUCA
  ATLANTICO
  BOLIVAR
  BOYACA
  CALDAS
  CAQUETA
  CASANARE
  CAUCA
  CESAR
  CHOCÓ
  CORDOBA
  CUNDINAMARCA
  GUAINIA
  GUAJIRA
  GUAVIARE
  HUILA
  MAGDALENA
  META
  NARIÑO
  NORTE_DE_SANTANDER
  PUTUMAYO
  QUINDIO
  RISARALDA
  SAN_ANDRES
  SANTANDER
  SUCRE
  TOLIMA
  VALLE_DEL_CAUCA
  VAUPES
  VICHADA
  OTRO
}

enum CiudadesUIUB {
  ACANDI
  ALTO_BAUDO
  ATRATO
  BAGADO
  BAHIA_SOLANO
  BAJO_BAUDO
  BOJAYA
  CANTON_DE_SAN_PABLO
  CARMEN_DEL_DARIEN
  CERTEGUI
  CONDOTO
  EL_CARMEN_DE_ATRATO
  ISTMINA
  JURADO
  LLORO
  MEDIO_ATRATO
  MEDIO_BAUDO
  MEDIO_SAN_JUAN
  NOVITA
  NUQUI
  QUIBDO
  RIO_IRE
